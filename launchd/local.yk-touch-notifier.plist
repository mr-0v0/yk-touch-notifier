<plist version="1.0">
<dict>
	<key>Label</key><string>local.yk-touch-notifier</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Applications/YK Touch Notifier.app/Contents/MacOS/yk-touch-notifier</string>
	</array>
	<key>RunAtLoad</key><true/>
